{
    "name": "xcopy/laravel-contacts",
    "description": "A simple Laravel package for managing polymorphic contact information for any Eloquent model.",
    "license": "MIT",
    "keywords": [
        "php",
        "laravel",
        "contacts",
        "phone",
        "email"
    ],
    "authors": [
        {
            "name": "Kairat Jenishev",
            "email": "kairat.jenishev@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/xcopy/laravel-contacts",
    "require": {
        "php": "^8.3",
        "egulias/email-validator": "^4.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "league/uri": "^7.8",
        "propaganistas/laravel-phone": "^6.0",
        "richan-fongdasen/eloquent-blameable": "^1.11",
        "spatie/laravel-package-tools": "^1.16",
        "xcopy/laravel-support": "dev-main"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.55",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Jenishev\\Laravel\\Contacts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jenishev\\Laravel\\Contacts\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jenishev\\Laravel\\Contacts\\ContactsServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    }
}
